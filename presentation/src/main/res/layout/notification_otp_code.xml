<?xml version="1.0" encoding="utf-8"?>
<!-- A one-time code in large type, inside a decorated notification, with who sent it above (some
     phones, like Samsung's, hide the title of a notification with its own layout). Code size is set
     in code from Settings > Message Sorting > Code notification size. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/sender"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />

    <TextView
        android:id="@+id/code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:textStyle="bold" />

</LinearLayout>
