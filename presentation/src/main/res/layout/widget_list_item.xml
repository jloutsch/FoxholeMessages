<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversation"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple"
    android:clickable="false"
    android:gravity="center_vertical|start"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:clickable="false"
        tools:background="@color/tools_theme">

        <TextView
            android:id="@+id/initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:gravity="center"
            android:textAllCaps="true"
            android:textSize="20sp"
            tools:text="A"
            tools:textColor="@color/textPrimaryDark" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:clickable="false"
            android:src="@drawable/ic_person_black_24dp"
            tools:tint="@color/textPrimaryDark" />

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            tools:src="@tools:sample/avatars" />

        <ImageView
            android:id="@+id/avatarMask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:src="@drawable/circle_mask" />

    </FrameLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/date"
            android:clickable="false"
            android:singleLine="true"
            android:textSize="16sp"
            tools:text="@tools:sample/full_names" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="16dp"
            android:clickable="false"
            android:textSize="12sp"
            tools:text="@tools:sample/date/day_of_week" />

        <TextView
            android:id="@+id/snippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/name"
            android:layout_alignParentStart="true"
            android:layout_alignWithParentIfMissing="true"
            android:layout_toStartOf="@id/unread"
            android:clickable="false"
            android:lines="1"
            android:singleLine="true"
            android:textSize="14sp"
            tools:text="@tools:sample/lorem" />

        <!-- The inbox's unread badge. A home-screen widget can't tint a background, so the
             coloured circle is an image under the count, pinned to the count's edges (a
             FrameLayout didn't stretch it, leaving a thin line). -->
        <RelativeLayout
            android:id="@+id/unread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/date"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:clickable="false"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/unreadBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/unreadCount"
                android:layout_alignTop="@+id/unreadCount"
                android:layout_alignEnd="@+id/unreadCount"
                android:layout_alignBottom="@+id/unreadCount"
                android:clickable="false"
                android:scaleType="fitXY"
                android:src="@drawable/circle"
                tools:tint="@color/tools_theme" />

            <TextView
                android:id="@+id/unreadCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="20dp"
                android:minHeight="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="3" />

        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>