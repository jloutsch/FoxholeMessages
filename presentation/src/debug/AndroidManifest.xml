<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build-only components. Merged into the debug manifest only; never in release/fdroid. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Fakes an incoming SMS on devices without a working SIM. See DebugInjectSmsReceiver.
             Exported so adb can reach it, but only to senders holding DUMP, which adb's shell has
             and ordinary apps can't get:
             adb shell am broadcast -n com.foxhole.messages.debug/dev.octoshrimpy.quik.receiver.DebugInjectSmsReceiver
             with string extras "address" and "body" (both optional). -->
        <receiver
            android:name="dev.octoshrimpy.quik.receiver.DebugInjectSmsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
