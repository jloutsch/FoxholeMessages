<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- targetPackage must be the INSTALLED app id, which differs per build (release,
         .debug, .fdroid), so each build type has its own copy of this file. It used to name
         dev.octoshrimpy.quik (upstream QUIK), so the "Compose" launcher shortcut opened nothing.
         ShortcutsXmlTest checks every copy against presentation/build.gradle. -->

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_compose"
        android:shortcutDisabledMessage="@string/shortcut_compose_disabled_message"
        android:shortcutId="compose"
        android:shortcutLongLabel="@string/shortcut_compose_long_label"
        android:shortcutShortLabel="@string/shortcut_compose_short_label">

        <intent
            android:action="dev.octoshrimpy.quik.START"
            android:targetClass="dev.octoshrimpy.quik.feature.compose.ComposeActivity"
            android:targetPackage="com.foxhole.messages.debug" />

        <categories android:name="android.shortcut.conversation" />

    </shortcut>

    <!-- Makes the per-thread shortcuts (ShortcutManagerImpl) sharing shortcuts. Android's docs
         require that for a notification to count as a conversation, and it lets the share sheet
         offer a thread directly (ComposeActivityModule reads the thread from the shortcut id). -->
    <share-target android:targetClass="dev.octoshrimpy.quik.feature.compose.ComposeActivity">
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
        <data android:mimeType="video/*" />
        <category android:name="dev.octoshrimpy.quik.SHARE_TARGET" />
    </share-target>

</shortcuts>
